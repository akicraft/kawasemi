{
	"name": "kawasemi",
	"version": "0.0.0",
	"description": "Astryx をベースにした個人開発用のデザインシステム（テーマ中心）",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akicraft/kawasemi.git"
	},
	"files": [
		"dist",
		"AGENTS.md"
	],
	"exports": {
		"./base.css": "./dist/base.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./themes/*.css": "./dist/themes/*/*.css",
		"./themes/*": {
			"types": "./dist/themes/*/*.d.ts",
			"default": "./dist/themes/*/*.js"
		},
		"./AGENTS.md": "./AGENTS.md",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"new-theme": "node scripts/new-theme.mjs",
		"check": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm --filter kawasemi-preview exec tsc --noEmit",
		"test": "playwright test",
		"test:update": "playwright test --update-snapshots"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans-jp": "5.3.1"
	},
	"peerDependencies": {
		"@astryxdesign/core": "~0.7.16",
		"@astryxdesign/theme-neutral": "~0.7.16",
		"tailwindcss": "^4.3"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	},
	"devDependencies": {
		"@astryxdesign/build": "0.7.16",
		"@astryxdesign/cli": "0.7.16",
		"@astryxdesign/core": "0.7.16",
		"@astryxdesign/theme-neutral": "0.7.16",
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"tailwindcss": "4.3.5"
	},
	"packageManager": "pnpm@12.11.0",
	"engines": {
		"node": ">=24.22"
	}
}
